digraph G {
    fontname="Helvetica"
    fontsize=14
    node [fontname="Helvetica", shape=box, style="filled,rounded", height=0.7, penwidth=1.5];
    edge [fontname="Helvetica", color="#666666", penwidth=2, arrowsize=0.8];
    rankdir="TB";
    splines="ortho";
    nodesep=0.6;
    ranksep=0.7;
    
    // Title
    labelloc="t";
    label="ELM Hydrology: Precipitation to Recharge";
    fontsize=20;
    fontweight="bold";

    // Precipitation
    PRECIP [label=<
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
            <TR><TD><B>Precipitation</B></TD></TR>
            <TR><TD><FONT FACE="Courier" POINT-SIZE="12">qflx_prec_grnd</FONT></TD></TR>
        </TABLE>
    >, fillcolor="#d4edfc", color="#3399ff"];

    subgraph cluster_canopy {
        label=<<B>Canopy</B>>;
        style="filled,rounded";
        fillcolor="#f2f9f2";
        color="#28a745";
        fontcolor="#155724";
        margin=25;

        H2OCAN [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                <TR><TD><B>H2OCAN</B></TD></TR>
                <TR><TD POINT-SIZE="11">(canopy water store)</TD></TR>
            </TABLE>
        >, fillcolor="#d4edda", color="#28a745"];

        CEVAP [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                <TR><TD><B>Evaporation</B></TD></TR>
                <TR><TD><FONT FACE="Courier" POINT-SIZE="12">qflx_evap_can</FONT></TD></TR>
            </TABLE>
        >, fillcolor="#fff3cd", color="#e6ac00"];

        THROUGH [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                <TR><TD><B>Throughfall &amp; drip</B></TD></TR>
                <TR><TD><FONT FACE="Courier" POINT-SIZE="11">qflx_through_rain</FONT></TD></TR>
                <TR><TD><FONT FACE="Courier" POINT-SIZE="11">qflx_through_snow</FONT></TD></TR>
                <TR><TD><FONT FACE="Courier" POINT-SIZE="11">qflx_drain_cansnow</FONT></TD></TR>
            </TABLE>
        >, fillcolor="#d4edda", color="#28a745"];

        {rank=same; CEVAP; H2OCAN; THROUGH;}
    }

    subgraph cluster_snow {
        label=<<B>Snow Pack</B>>;
        style="filled,rounded";
        fillcolor="#f5fbfe";
        color="#5bc0de";
        fontcolor="#0c5460";
        margin=25;

        H2OSNO [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                <TR><TD><B>H2OSNO</B></TD></TR>
                <TR><TD POINT-SIZE="11">(snow water store)</TD></TR>
            </TABLE>
        >, fillcolor="#e8f4fd", color="#5bc0de"];

        SNOWMELT [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                <TR><TD><B>Snowmelt</B></TD></TR>
                <TR><TD><FONT FACE="Courier" POINT-SIZE="12">qflx_snow_melt</FONT></TD></TR>
            </TABLE>
        >, fillcolor="#e8f4fd", color="#5bc0de"];

        SUBLIMATION [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                <TR><TD><B>Sublimation</B></TD></TR>
                <TR><TD><FONT FACE="Courier" POINT-SIZE="12">qflx_sub_snow</FONT></TD></TR>
            </TABLE>
        >, fillcolor="#fff3cd", color="#e6ac00"];

        {rank=same; SNOWMELT; H2OSNO; SUBLIMATION;}
    }

    subgraph cluster_surface {
        label=<<B>Soil Surface</B>>;
        style="filled,rounded";
        fillcolor="#fffdf5";
        color="#e6ac00";
        fontcolor="#856404";
        margin=25;

        POND [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                <TR><TD><B>Ponded water</B></TD></TR>
                <TR><TD><FONT FACE="Courier" POINT-SIZE="12">fh2osfc</FONT></TD></TR>
            </TABLE>
        >, fillcolor="#fff3cd", color="#e6ac00"];

        RUNOFF [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                <TR><TD><B>Surface runoff</B></TD></TR>
                <TR><TD><FONT FACE="Courier" POINT-SIZE="12">qflx_surf</FONT></TD></TR>
            </TABLE>
        >, fillcolor="#f8d7da", color="#dc3545"];

        INFIL [label=<
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0
           
                <TR><TD>
            </T
        >, fillcolor="#fff3cd", color="#e6ac00"];
        
        {rank=same; RUNOFF; POND; 
    }

    subgraph cluster_soil {
        label=<<B>Soil Column (j = 1 ... 
        style="fi
        fillcolor="#
        color="#
        fontcolo
    

        L1 
            <TABL
                <TR><TD><B>Layer 1</B></TD></TR>
    
            </TA
        >, fillcolor="

        SEVAP [label
            <TABLE 
                <TR><TD><B>Soil evaporation</B></TD></TR>
                <TR><TD><FONT FACE="Courier" POINT
                <TR><TD POINT-SIZE="11">(top layer only)</TD></TR>
            </TABLE>


        L2 [lab
            <TABLE BORDER="0" CELLBORDER="0" 

                <TR><TD><FONT
            </TABLE>
        >
        
        DOTS [label=".

        LN [label=<
       
                <TR><TD>
                <TR><TD><FON
            </TABL


        TRANSP [label=
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0">
                <TR><TD><B>Transpiration sink</
                <TR><TD><FONT FACE="Courier" POINT-SIZE="12">qflx_root
            </TABLE>
        >, fillcolor="#f8d7da", color="#dc3545"];

        {rank=same; SE
    }

    RECHARGE [label=<
        <TABLE BORDER="0" CELLBO
            <TR><TD><B>Aquifer recharge</B></TD></TR
            <TR><TD><FONT FACE="Courier" POINT-SIZE="12">qflx_recharge</FONT></TD></TR>
   
        </TABLE>
   

    // Connections
    PRECIP -> H2OCAN;

    H2


    THROUGH -> H2OSNO [
    THROUGH -> POND [label=" rain/drip", fontcolor="#555555",

    H2OSNO -> SUBLIMATION [style="dashed", color="#e6ac00"];
 

    SNOWMELT -> POND;

    POND -> RUNOFF [style="dashed", color="#dc3545"];
    POND -> INFIL

    INFIL -> L1;

    L1 -> SEVAP [style="dashed", color="#e6ac00"];
    L1 -> L2;
    L2 -> D
    DOTS -> LN;

    // Transpiration links
    L1 -> TRANSP [style="dashed", color="#dc3545"];

    LN -> TRANSP [st

